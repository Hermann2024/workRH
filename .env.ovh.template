# WorkRH OVH production environment for www.workrh.lu
# Copy to .env.local on the OVH host and fill every empty secret/value.

WORKRH_FRONTEND_ORIGIN=https://www.workrh.lu
WORKRH_PUBLIC_BASE_URL=https://www.workrh.lu
WORKRH_PUBLIC_PORT=9080
WORKRH_DEMO_AUTHENTICATION_ENABLED=false
WORKRH_PRODUCTION_READINESS_ENFORCED=true
WORKRH_HIBERNATE_DDL_AUTO=validate

# Docker images
WORKRH_IMAGE_REGISTRY=
WORKRH_IMAGE_TAG=1.0.0

# Security secrets
# Generate Base64 32-byte values, for example:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
WORKRH_JWT_SECRET=
WORKRH_CONNECTOR_SECRET_KEY=
WORKRH_SUBSCRIPTION_BOOTSTRAP_KEY=
WORKRH_WORKSPACE_INTERNAL_KEY=
WORKRH_NOTIFICATION_INTERNAL_KEY=

# Databases
WORKRH_DATABASE_USERNAME=
WORKRH_DATABASE_PASSWORD=
WORKRH_USERS_DATABASE_URL=
WORKRH_LEAVES_DATABASE_URL=
WORKRH_SICKNESS_DATABASE_URL=
WORKRH_TELEWORK_DATABASE_URL=
WORKRH_NOTIFICATIONS_DATABASE_URL=
WORKRH_REPORTING_DATABASE_URL=
WORKRH_SUBSCRIPTIONS_DATABASE_URL=

# Messaging
WORKRH_KAFKA_BOOTSTRAP_SERVERS=

# Stripe live mode
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_SMS_OPTION=
STRIPE_PRICE_ADVANCED_AUDIT_OPTION=
STRIPE_PRICE_ADVANCED_EXPORT_OPTION=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
WORKRH_SUPPORT_FROM_EMAIL=support@workrh.lu
WORKRH_SUPPORT_ADMIN_EMAIL=workrhsolution@gmail.com

# Operations
WORKRH_BACKUP_DIR=/var/backups/workrh
WORKRH_INCIDENT_CONTACT=ops@workrh.lu

# Optional commercial capabilities
WORKRH_ENTERPRISE_ENABLED=false
WORKRH_SMS_ENABLED=false
WORKRH_SMS_PROVIDER=
WORKRH_SMS_FROM=WorkRH
WORKRH_SMS_WEBHOOK_URL=
WORKRH_SMS_API_KEY=
